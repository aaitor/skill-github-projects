# Shared Aitor terminal style. MIT. Source: https://github.com/aaitor/assets
Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 20
Set Width 1100
Set Height 580
Set Padding 28
Set WindowBar Colorful
Set BorderRadius 14
Set TypingSpeed 45ms
Set Theme { "name": "Aitor", "background": "#101827", "foreground": "#F4F7FB", "black": "#101827", "red": "#F28B82", "green": "#89E5CC", "yellow": "#F6D78B", "blue": "#9CAEC4", "magenta": "#C2ACEE", "cyan": "#89E5CC", "white": "#F4F7FB", "brightBlack": "#6A7D94", "brightRed": "#F28B82", "brightGreen": "#89E5CC", "brightYellow": "#F6D78B", "brightBlue": "#9CAEC4", "brightMagenta": "#C2ACEE", "brightCyan": "#89E5CC", "brightWhite": "#FFFFFF", "cursor": "#89E5CC", "selection": "#37516A" }
